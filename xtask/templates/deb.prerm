#!/bin/sh
set -e

# Remove the /usr/local/bin symlinks we installed in postinst.
# Only unlink if they actually point back at /opt/buffr — leave
# unrelated files alone.
for bin in buffr buffr-app buffr-helper; do
    if [ -L "/usr/local/bin/$bin" ]; then
        target="$(readlink "/usr/local/bin/$bin" 2>/dev/null || true)"
        if [ "$target" = "/opt/buffr/$bin" ]; then
            rm -f "/usr/local/bin/$bin"
        fi
    fi
done

exit 0
